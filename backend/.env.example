PORT=3000
# Browser origin(s) allowed for CORS + credentialed requests. One URL, or comma-separated (prod + Vercel preview, etc.).
CLIENT_ORIGIN=http://localhost:5173
# Cross-site SPA (Vercel + API host): cookies use SameSite=None; Secure when NODE_ENV=production (HTTPS required).
# If NODE_ENV is not production on the server but you still need that behavior: AUTH_COOKIE_CROSS_SITE=1

# Required in production. Generate: openssl rand -hex 32
AUTH_SECRET=

# Set to 1 when behind a reverse proxy (nginx, Railway, Render, etc.) so rate limits and IP logging use the real client IP.
# TRUST_PROXY=1

# Neon: use sslmode=verify-full (or add uselibpqcompat=true) to silence pg SSL mode warnings — see node-pg docs.
DATABASE_URL=postgresql://user:password@localhost:5432/game

# Google OAuth 2.0 (Sign in with Google — server-side flow; see frontend login “Continue with Google”)
# Create OAuth client (Web application). Authorized redirect URI must be exactly:
#   {PUBLIC_API_ORIGIN}/api/auth/google/callback
# e.g. http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# API origin (no trailing slash). Used to build the Google redirect URI if GOOGLE_REDIRECT_URI is unset.
# On Render, omit if RENDER_EXTERNAL_URL is set. On Railway, omit if RAILWAY_PUBLIC_DOMAIN is set.
# LOCAL: PUBLIC_API_ORIGIN=http://localhost:3000
# PUBLIC_API_ORIGIN=
# Optional override of the full redirect URI. If unset, defaults to PUBLIC_API_ORIGIN + /api/auth/google/callback
# You may set only the path: GOOGLE_REDIRECT_URI=/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# Klipy GIF API (server-side proxy at GET /api/klipy/gifs/* — avoids browser CORS)
# KLIPY_API_KEY=your-klipy-key

# Meme Battle (seconds, optional)
# MEME_CONTEXT_VOTE_SEC=45
# MEME_CONTEXT_RESULT_SEC=4
# MEME_GIF_PICK_SEC=90
# MEME_REVEAL_SEC=5
# MEME_GIF_VOTE_SEC=45
# MEME_ROUND_BREAK_SEC=6
# MEME_LEADERBOARD_SEC=8
# MAX_MEME_ROUNDS=3



# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# TMDB_API_KEY=   # Used by `npm run seed:game-items` (Who Am I? dataset), not during live play
# Optional seed tuning (defaults are strict: ~100 easy characters + ~100 easy people):
# SEED_CHARACTERS=100 SEED_PEOPLE=100
# SEED_MOVIE_MIN_VOTES=4500 SEED_MOVIE_MIN_POPULARITY=14 SEED_MAX_MOVIES_FOR_CREDITS=55
# SEED_CAST_MAX_ORDER=7 SEED_CAST_MIN_POPULARITY=2.8
# SEED_PERSON_MIN_POPULARITY=18 SEED_PERSON_MIN_KNOWN_FOR_VOTES=2200 SEED_PERSON_POPULAR_PAGES=18
# SEED_USE_WIKIDATA_PEOPLE=1 SEED_WD_MIN_SITELINKS=105
# Wikidata-only characters (npm run seed:wikidata-characters): SEED_WD_CHARACTERS=100 SEED_WD_CHAR_MIN_SITELINKS=72
