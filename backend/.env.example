PORT=3000
# Browser origin(s) allowed for CORS + credentialed requests. One URL, or comma-separated (prod + Vercel preview, etc.).
CLIENT_ORIGIN=http://localhost:5173
# Cross-site SPA (Vercel + API host): cookies use SameSite=None; Secure when NODE_ENV=production (HTTPS required).
# If NODE_ENV is not production on the server but you still need that behavior: AUTH_COOKIE_CROSS_SITE=1

# Required in production. Generate: openssl rand -hex 32
AUTH_SECRET=

# Set to 1 when behind a reverse proxy (nginx, Railway, Render, etc.) so rate limits and IP logging use the real client IP.
# TRUST_PROXY=1

# Neon: use sslmode=verify-full (or add uselibpqcompat=true) to silence pg SSL mode warnings — see node-pg docs.
DATABASE_URL=postgresql://user:password@localhost:5432/game

# Klipy GIF API (server-side proxy at GET /api/klipy/gifs/* — avoids browser CORS)
# KLIPY_API_KEY=your-klipy-key

# Meme Battle (seconds, optional)
# MEME_CONTEXT_VOTE_SEC=45
# MEME_CONTEXT_RESULT_SEC=4
# MEME_GIF_PICK_SEC=90
# MEME_REVEAL_SEC=5
# MEME_GIF_VOTE_SEC=45
# MEME_ROUND_BREAK_SEC=6
# MEME_LEADERBOARD_SEC=8
# MAX_MEME_ROUNDS=3
