# Client-side env vars must be prefixed with VITE_
# Restart `npm run dev` after changing this file.
#
# REST: backend serves routes under /api — you can set either host or full /api URL:
# VITE_API_URL=http://localhost:3000
# VITE_API_URL=http://localhost:3000/api
#
# Socket.IO is on the HTTP server root (not under /api):
# VITE_SOCKET_URL=http://localhost:3000
#
# GIF search uses the backend proxy (set KLIPY_API_KEY in backend/.env), not a browser key.
#
# --- Vercel / production (set in Vercel → Project → Settings → Environment Variables) ---
# Use your real API host (HTTPS). No trailing slash required; /api is appended in code.
# VITE_API_URL=https://your-api.example.com
# VITE_SOCKET_URL=https://your-api.example.com


# Google OAuth (configure in Google Cloud Console → Credentials → OAuth 2.0 Client)
# Server-side only — set these in backend/.env (not in Vite; never expose client secret to the browser).
# Backend must register this exact path with Google: /api/auth/google/callback (see backend/.env PUBLIC_API_ORIGIN + GOOGLE_REDIRECT_URI)